# Self-hosted dashboard image. The upstream hosted dashboard is deployed
# separately, but Docker Compose installations need a reproducible local UI.
FROM oven/bun:1.4.0 AS builder

WORKDIR /build

COPY package.json bun.lock* bunfig.toml ./
COPY apps/ui/package.json ./apps/ui/package.json
COPY apps/templates-ui/package.json ./apps/templates-ui/package.json
COPY apps/evals/package.json ./apps/evals/package.json
RUN bun install --frozen-lockfile

COPY apps/ui/ ./apps/ui/
# Git stores this path as a symlink. Copy the target explicitly so Windows
# checkouts that materialize symlinks as text still produce a valid build.
COPY src/be/modelsdev-cache.json ./apps/ui/src/lib/modelsdev-cache.json
# The dashboard shares citation types with the API source tree.
COPY src/utils/task-citations.ts ./src/utils/task-citations.ts
RUN cd apps/ui && bun run build

FROM nginx:1.27.5-alpine

COPY --from=builder /build/apps/ui/dist /usr/share/nginx/html
COPY nginx-ui.conf /etc/nginx/conf.d/default.conf

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

